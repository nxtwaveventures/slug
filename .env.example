# Get a free key at https://aistudio.google.com/apikey
# Use a FREE key only for testing with mock/role-played consultations.
# Before real patients, switch to a PAID (billed) key so conversation audio is
# NOT used to train Google's models.
GEMINI_API_KEY=your_key_here
PORT=3000

# Shared access code that gates the API (so a public URL isn't wide open).
# Set this on Vercel too. If unset, the gate is DISABLED (open) — fine for local
# dev, but always set it in production.
ACCESS_CODE=choose-a-code
